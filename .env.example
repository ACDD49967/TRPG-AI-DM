# ============================================================
# AI Dungeon Master — 环境配置
# ============================================================
# 将此文件复制为 .env 并填入你的 API Key
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux/macOS)
# ============================================================

# 必填：LLM API Key（OpenAI / DeepSeek / 其他 OpenAI 兼容服务）
LLM_API_KEY=sk-your-api-key-here

# 可选：API 地址（默认 OpenAI 兼容格式；DeepSeek 可改为 https://api.deepseek.com/v1）
# LLM_BASE_URL=https://api.openai.com/v1

# 可选：模型名称（留空则在前端填写/自动获取）
# LLM_MODEL_NAME=

# 可选：服务端口
# PORT=8000
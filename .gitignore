world_states/
!world_states/.gitkeep
saves/
!saves/.gitkeep
extensions/
!extensions/.gitkeep
characters/*
!characters/.gitkeep

# 打包产物
dist/
*.zip
*.tgz

# IDE / OS / 本机开发辅助
.idea/
.vscode/
.DS_Store
Thumbs.db
.claude/
.dsh-plugins/
dsh-routing-suite/
.git-ssl/
.install-cache/

# 日志
*.log
npm-debug.log*

# 评估产生的原始 JSON 与样本文件（保留 Markdown 报告即可）
eval_results/*.json
eval_results/samples/

# 用户知识库数据（保留目录）
knowledge_base/*.json

# 用户存档与扩展包数据（保留目录）
saves/*.json
extensions/*.json

# 用户媒体资源（地图/生物/角色图片）
media/*
!media/.gitkeep

# 临时/下载数据
data/
_backend_launch.bat
_frontend_launch.bat

test/

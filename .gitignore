__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Node
node_modules/
frontend/dist/
*.tsbuildinfo

# 环境与密钥
.env
.env.local
*.pem
*.crt
*.key

# 运行时数据（用户生成内容）
dndgame.db
*.sqlite3
scenarios/
